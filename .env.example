APP_TITLE=CampusDigest
APP_DESCRIPTION=Публичные новости вузов и студенческие объявления
HOST=127.0.0.1
PORT=8006
DEBUG=false
DOMAIN=false
DOMAIN_NAME=http://127.0.0.1:8006/
POSTGRES_DB=campusdigest
POSTGRES_USER=campusdigest
POSTGRES_PASSWORD=replace-with-local-database-password
DB_HOST=localhost
DB_PORT=5432
SECRET=replace-with-your-random-secret
PARSER_FREQUENCY=30
STORAGE_DAYS=30
ENABLE_SCHEDULER=false
# После применения миграций можно включить автоматический сбор и очистку.
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password
BOT_ENABLED=false
BOT_TOKEN=
WEBHOOK=false
INSTANT_VIEW=false
# Только для локальных ORM-проверок без PostgreSQL (старые миграции требуют PostgreSQL):
# DATABASE_URL=sqlite+aiosqlite:///./campusdigest-test.db
